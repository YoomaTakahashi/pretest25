   * releases — closing a dialog must not steal focus back from whatever the
   * user just clicked. A blur to `<body>` still restores.
   *
   * @default true
   *
   * @example
   * ```ts
   * useFocusTrap(panel, { restore: false })
   * ```
   */
  restore?: boolean;
